# URL of the BarnizGallery backend
VITE_API_URL=http://localhost:8080
# true = every service uses simulated data (no backend needed)
VITE_USE_MOCKS=true
# Services that already exist in the backend use the real API even when mocks are on.
# Comma separated: auth,catalog,profile,gallery,commerce,auction,customOrder,messaging,notification,artisan,admin
VITE_REAL_SERVICES=
